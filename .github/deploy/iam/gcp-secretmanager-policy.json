{
  "bindings": [
    {
      "role": "roles/secretmanager.secretAccessor",
      "members": [
        "serviceAccount:trustpassz-server-runner@trustpassz-prod.iam.gserviceaccount.com",
        "serviceAccount:trustpassz-cicd-runner@trustpassz-prod.iam.gserviceaccount.com"
      ],
      "condition": {
        "title": "Strict TrustPassz Secrets Only",
        "description": "Grant access strictly to trustpassz production secret resources",
        "expression": "resource.name.startsWith('projects/trustpassz-prod/secrets/TRUSTPASSZ_')"
      }
    }
  ],
  "version": 3
}

