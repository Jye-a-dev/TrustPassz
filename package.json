{
  "name": "trustpassz-root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/e2e"
  ],
  "scripts": {
    "mb": "npm --prefix apps/mb_user run dev",
    "mb:clean": "npm --prefix apps/mb_user run clean",
    "user": "npm --prefix apps/cl_user run dev",
    "admin": "npm --prefix apps/cl_admin run dev",
    "server": "npm --prefix apps/server run dev",
    "pipe": "npm --prefix apps/ai_pipeline run dev",
    "structure": "node scripts/draw-structure.js",
    "test:e2e": "npm --prefix tests/e2e test"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "@types/react": "18.3.12"
  }
}
