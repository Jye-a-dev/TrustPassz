# TrustPassz AI Pipeline — .env.example
# Copy thành .env rồi chỉnh giá trị phù hợp với môi trường.
# Zero Cloud API: toàn bộ inference chạy local qua Outlines Logit Masking.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3100
ENVIRONMENT=development

# ── CORS (comma-separated, thêm origin frontend nếu deploy khác host) ─────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Local sVLM model ───────────────────────────────────────────────────────────
# HuggingFace model ID (tự download lần đầu) hoặc đường dẫn tuyệt đối cục bộ
# Ví dụ local: AI_MODEL_PATH=D:/models/Qwen2-VL-2B-Instruct
AI_MODEL_PATH=Qwen/Qwen2-VL-2B-Instruct

# Thiết bị tính toán: auto | cuda | mps | cpu
AI_DEVICE=auto

# Kích thước ảnh đầu vào (letterbox square, pixels)
AI_IMAGE_SIZE=512

# ── TASK-07: Arbitration Engine ────────────────────────────────────────────────
# Ngưỡng confidence: verdict dưới mức này tự động ESCALATE_TO_ADMIN
ARBITRATION_CONFIDENCE_THRESHOLD=0.75

# Timeout (giây) cho mỗi lần fetch ảnh bằng chứng từ Supabase Storage URL
EVIDENCE_FETCH_TIMEOUT=10
