# Environment variables for TrustPassz AI Pipeline (TASK-06)
# Zero Cloud API — runs fully offline once model weights are cached.

# ── Server config ─────────────────────────────────────────────────────────────
PORT=3100
ENVIRONMENT=development

# ── CORS origins (comma-separated) ───────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Local sVLM model config ───────────────────────────────────────────────────
# HuggingFace model ID or absolute local path inside models/
AI_MODEL_PATH=Qwen/Qwen2-VL-2B-Instruct

# Compute device: "cuda" for GPU, "cpu" for CPU-only, "auto" for auto-detect
AI_DEVICE=auto

# Image resize before feeding to vision model (pixels, square)
AI_IMAGE_SIZE=512
