# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES — NEVER PUT SERVER SECRETS HERE
# apps/cl_user/.env.example
# ==============================================================================

# User Portal Host URL (Next.js client port: 5000)
NEXT_PUBLIC_APP_URL="http://localhost:5000"

# TrustPassz Backend REST API URL (NestJS server port: 3001)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Base Sepolia Smart Contract Address (TASK-02)
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x165B47291B87569b91696DCE6f1207eE15C9f783

# Google OAuth Client ID for Web Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# Solana SIWS & RPC Network Configuration (TASK-03)
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"

# Supabase Auxiliary Realtime & Storage Client (Anon Key only)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-supabase-anon-key"

# Port configuration
PORT=5000
NODE_ENV="development"
