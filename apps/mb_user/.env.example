# Backend REST API Host URL (Vite Web & Capacitor Native via 10.0.2.2 or LAN IP)
VITE_API_URL="http://10.0.2.2:3001"
VITE_LAN_API_URL="http://192.168.1.100:3001"
EXPO_PUBLIC_API_URL="http://10.0.2.2:3001"

# AI Pipeline Linkage URL (TASK-06 / TASK-07)
VITE_AI_PIPELINE_URL="http://10.0.2.2:3100"

# Google OAuth Web Client ID for Mobile / Native Token Exchange
VITE_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# Base Sepolia Smart Contract Address (TASK-02)
VITE_ESCROW_CONTRACT_ADDRESS="0xef976eb14fdba8cb722789b451e2b9f903005c26"
EXPO_PUBLIC_ESCROW_CONTRACT_ADDRESS=0xef976eb14fdba8cb722789b451e2b9f903005c26
