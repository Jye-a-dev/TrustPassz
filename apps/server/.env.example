# ==============================================================================
# SERVER-ONLY SECRETS — NEVER EXPOSE TO CLIENTS
# apps/server/.env.example (TASK-a-10 Anti-Idle, Rate Limiting & Resiliency)
# ==============================================================================

# Neon Serverless PostgreSQL (Primary Relational Engine - OLTP)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>-pooler.<REGION>.aws.neon.tech/<DB_NAME>?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<USER>:<PASSWORD>@<HOST>.<REGION>.aws.neon.tech/<DB_NAME>?sslmode=require"

# Supabase Auxiliary BaaS (Object Storage & Realtime Channels)
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"
SUPABASE_STORAGE_BUCKET="dispute-evidences"

# Web3 & Escrow Smart Contract Infrastructure (Base Sepolia - TASK-02 & TASK-a-7)
ESCROW_CONTRACT_ADDRESS="0xef976eb14fdba8cb722789b451e2b9f903005c26"
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
ORACLE_RELAYER_PRIVATE_KEY="0x<64_HEX_ORACLE_RELAYER_PRIVATE_KEY>"
ALCHEMY_API_KEY="your_alchemy_api_key"
INFURA_API_KEY="your_infura_api_key"

# Server Runtime & Security
PORT=3001
NODE_ENV="development"
JWT_SECRET="your_production_grade_jwt_secret_minimum_32_characters"
TRUST_PROXY=1
ENABLE_SWAGGER=true

# Anti-Idle & Keep-Alive Service (TASK-a-10)
# Lightweight query to Neon PostgreSQL (SELECT 1;) to prevent scale-to-zero
KEEP_ALIVE_ENABLED="true"
KEEP_ALIVE_INTERVAL_CRON="*/4 * * * *"
SERVER_HEALTH_URL="http://127.0.0.1:3001/api/v1/health"
AI_PIPELINE_HEALTH_URL="http://127.0.0.1:3100/health"

# Strict CORS Whitelist Policy (TASK-14 & TASK-a-10)
# Comma-separated list. Wildcard '*' is strictly prohibited on Staging/Production.
CORS_ALLOWED_ORIGINS="http://localhost:5000,http://localhost:5100,http://localhost:3100,https://trustpassz.vercel.app,https://www.trustpassz.io"

# API Throttling & DDOS Protection (TASK-14 & TASK-a-10)
# Standard rate limiters with HTTP 429 and Retry-After response header
THROTTLE_TTL=60
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL=60
THROTTLE_WEBHOOK_LIMIT=60
THROTTLE_WEBHOOK_TTL=60
THROTTLE_DEALS_LIMIT=20
THROTTLE_DEALS_WRITE_LIMIT=20
THROTTLE_DEALS_TTL=60

# AI Pipeline Linkage (TASK-07 & TASK-a-10)
AI_PIPELINE_URL="http://127.0.0.1:3100"

# Solana SIWS & RPC Network Configuration
SOLANA_NETWORK="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"

# Google OAuth Setup
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# PayOS VietQR Payment Gateway (TASK-05)
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"
PAYOS_RETURN_URL="https://trustpassz.io/checkout/success"
PAYOS_CANCEL_URL="https://trustpassz.io/checkout/cancel"
