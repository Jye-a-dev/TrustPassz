// apps/server/prisma/schema.prisma
// ==============================================================================
// TRUSTPASSZ HYBRID DATABASE SCHEMA (TASK-03)
// Primary Relational Engine: Neon PostgreSQL (pgBouncer Pool + Direct DDL)
// Auxiliary BaaS Engine: Supabase (Evidence Storage & Deal Room Realtime)
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// ==============================================================================
// 1. ENUMS DEFINITIONS
// ==============================================================================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  ARBITRATOR

  @@map("user_role_enum")
}

enum DealState {
  PENDING
  DEPOSITED
  IN_INSPECTION
  SETTLED
  REFUNDED
  DISPUTED

  @@map("deal_state_enum")
}

enum ChainType {
  BASE_SEPOLIA
  SOLANA_DEVNET
  SOLANA_MAINNET

  @@map("chain_type_enum")
}

enum AssetType {
  SOURCE_CODE
  LICENSE_KEY
  ACCOUNT_CREDENTIAL
  DESIGN_ASSET
  OTHER

  @@map("asset_type_enum")
}

enum DisputeStatus {
  OPENED
  AI_PROCESSING
  AI_RESOLVED
  ADMIN_ESCALATED
  CLOSED

  @@map("dispute_status_enum")
}

enum ArbitrationVerdict {
  APPROVE_PAYOUT
  TRIGGER_REFUND
  ESCALATE_TO_ADMIN

  @@map("arbitration_verdict_enum")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD_OUT
  ARCHIVED

  @@map("product_status_enum")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_ESCROW
  PROCESSING
  SHIPPING
  IN_INSPECTION
  COMPLETED
  DISPUTED
  CANCELLED

  @@map("order_status_enum")
}

enum BargainStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("bargain_status_enum")
}

// ==============================================================================
// 2. CORE IDENTITY & SOCIAL-COMMERCE MODELS
// ==============================================================================

model User {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String?  @unique @db.VarChar(255)
  phone         String?  @unique @db.VarChar(20)
  walletAddress String?  @unique @map("wallet_address") @db.VarChar(100)
  displayName   String?  @map("display_name") @db.VarChar(100)
  avatarUrl     String?  @map("avatar_url") @db.Text
  password      String?  @db.VarChar(255)
  role          UserRole @default(USER)
  isFrozen      Boolean  @default(false) @map("is_frozen")
  kycStatus     String   @default("VERIFIED") @map("kyc_status") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  storefront        Storefront?
  sellerProducts    Product[]      @relation("SellerProducts")
  sellerDeals       Deal[]         @relation("SellerDeals")
  buyerDeals        Deal[]         @relation("BuyerDeals")
  buyerOrders       Order[]        @relation("BuyerOrders")
  sellerOrders      Order[]        @relation("SellerOrders")
  bargainOffers     BargainOffer[] @relation("BuyerBargains")
  initiatedDisputes DisputeLog[]        @relation("InitiatorDisputes")
  resolvedDisputes  DisputeLog[]        @relation("ResolverDisputes")
  relayerFundingLogs RelayerFundingLog[] @relation("AdminRelayerFunding")
  auditLogs          AuditLog[]          @relation("AdminAuditLogs")
  fiatFundingOrders  FiatCryptoFundingOrder[] @relation("AdminFiatOrders")
  deviceTokens       DeviceToken[]

  @@map("users")
}

model Storefront {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sellerId     String   @unique @map("seller_id") @db.Uuid
  slug         String   @unique @db.VarChar(100)
  shopName     String   @map("shop_name") @db.VarChar(150)
  bio          String?  @db.Text
  customConfig Json     @default("{\"theme\":\"dark\",\"social_links\":{},\"banner_url\":null,\"canvas_layout\":[]}") @map("custom_config")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller   User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("storefronts")
}

model Product {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sellerId       String        @map("seller_id") @db.Uuid
  storefrontId   String?       @map("storefront_id") @db.Uuid
  title          String        @db.VarChar(255)
  category       String        @db.VarChar(50)
  basePrice      Decimal       @map("base_price") @db.Decimal(18, 4)
  floorPrice     Decimal?      @map("floor_price") @db.Decimal(18, 4)
  currency       String        @default("VND") @db.VarChar(10)
  status         ProductStatus @default(ACTIVE)
  specAttributes Json          @default("{\"tags\":[],\"media_gallery\":[],\"ai_defect_fingerprints\":[],\"delivery_method\":\"INSTANT_VAULT\"}") @map("spec_attributes")
  ruleConfig     Json          @default("{\"inspection_hours\":12,\"allow_bargain\":true,\"deposit_fee_rate\":1.0,\"anti_boom_deposit_amount\":0}") @map("rule_config")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller        User           @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Restrict)
  storefront    Storefront?    @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  orders        Order[]
  bargainOffers BargainOffer[]

  @@index([sellerId])
  @@index([status])
  @@map("products")
}

// ==============================================================================
// 3. CORE ESCROW, ORDERS & REALTIME BARGAIN MODELS
// ==============================================================================

model Deal {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  chainType             ChainType @default(BASE_SEPOLIA) @map("chain_type")
  onchainDealId         String?   @unique @map("onchain_deal_id") @db.VarChar(128)
  solanaPdaAddress      String?   @map("solana_pda_address") @db.VarChar(64)
  buyerWallet           String?   @map("buyer_wallet") @db.VarChar(100)
  sellerWallet          String?   @map("seller_wallet") @db.VarChar(100)
  depositTxHash         String?   @map("deposit_tx_hash") @db.VarChar(128)
  sellerId              String    @map("seller_id") @db.Uuid
  buyerId               String?   @map("buyer_id") @db.Uuid
  title                 String    @db.VarChar(255)
  description           String?   @db.Text
  amount                Decimal   @db.Decimal(18, 4)
  currency              String    @default("VND") @db.VarChar(10)
  state                 DealState @default(PENDING)
  inspectionDuration    Int       @default(86400) @map("inspection_duration")
  depositedAt           DateTime? @map("deposited_at") @db.Timestamptz(6)
  inspectionDeadline    DateTime? @map("inspection_deadline") @db.Timestamptz(6)
  paymentOrderCode      BigInt?   @unique @map("payment_order_code")
  paymentRefId          String?   @map("payment_ref_id") @db.VarChar(100)
  webhookIdempotencyKey String?   @unique @map("webhook_idempotency_key") @db.VarChar(128)
  settleTxHash          String?   @map("settle_tx_hash") @db.VarChar(128)
  disputeTxHash         String?   @map("dispute_tx_hash") @db.VarChar(128)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller       User          @relation("SellerDeals", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer        User?         @relation("BuyerDeals", fields: [buyerId], references: [id], onDelete: SetNull)
  order        Order?
  digitalAsset DigitalAsset?
  disputeLogs  DisputeLog[]

  @@index([sellerId])
  @@index([buyerId])
  @@index([state])
  @@index([onchainDealId])
  @@index([paymentOrderCode])
  @@index([chainType])
  @@index([solanaPdaAddress])
  @@map("deals")
}

model Order {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderNumber     String      @unique @map("order_number") @db.VarChar(64)
  dealId          String      @unique @map("deal_id") @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  sellerId        String      @map("seller_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  status          OrderStatus @default(PENDING_PAYMENT)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(18, 4)
  shippingInfo    Json        @default("{\"is_physical\":false,\"recipient_email\":null,\"shipping_address\":null,\"carrier_tracking_code\":null,\"carrier_name\":null,\"shipping_fee\":0}") @map("shipping_info")
  paymentMetadata Json        @default("{}") @map("payment_metadata")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Restrict)
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller  User    @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("orders")
}

model BargainOffer {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  buyerId         String        @map("buyer_id") @db.Uuid
  offeredPrice    Decimal       @map("offered_price") @db.Decimal(18, 4)
  status          BargainStatus @default(PENDING)
  negotiationData Json          @default("{\"buyer_note\":\"\",\"ai_suggested\":false,\"session_socket_id\":null}") @map("negotiation_data")
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation("BuyerBargains", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([buyerId])
  @@map("bargain_offers")
}

// ==============================================================================
// 4. DIGITAL VAULT & ARBITRATION MODELS
// ==============================================================================

model DigitalAsset {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  dealId           String    @unique @map("deal_id") @db.Uuid
  assetType        AssetType @default(SOURCE_CODE) @map("asset_type")
  encryptedContent String    @map("encrypted_content") @db.Text
  encryptionIv     String    @map("encryption_iv") @db.VarChar(64)
  authTag          String    @map("auth_tag") @db.VarChar(64)
  contentHash      String?   @map("content_hash") @db.VarChar(64)
  fileName         String?   @map("file_name") @db.VarChar(255)
  fileSizeBytes    BigInt?   @map("file_size_bytes")
  accessCount      Int       @default(0) @map("access_count")
  maxAccessLimit   Int       @default(1) @map("max_access_limit")
  unlockedAt       DateTime? @map("unlocked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("digital_assets")
}

model DisputeLog {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  dealId            String              @map("deal_id") @db.Uuid
  initiatorId       String              @map("initiator_id") @db.Uuid
  status            DisputeStatus       @default(OPENED)
  reason            String              @db.Text
  evidenceUrls      Json                @default("[]") @map("evidence_urls")
  aiVerdict         ArbitrationVerdict? @map("ai_verdict")
  aiConfidenceScore Decimal?            @map("ai_confidence_score") @db.Decimal(5, 4)
  aiExplanation     String?             @map("ai_explanation") @db.Text
  aiAnalyzedAt      DateTime?           @map("ai_analyzed_at") @db.Timestamptz(6)
  adminVerdict      ArbitrationVerdict? @map("admin_verdict")
  resolvedById      String?             @map("resolved_by_id") @db.Uuid
  resolutionNote    String?             @map("resolution_note") @db.Text
  resolvedAt        DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  deal       Deal  @relation(fields: [dealId], references: [id], onDelete: Restrict)
  initiator  User  @relation("InitiatorDisputes", fields: [initiatorId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("ResolverDisputes", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([status])
  @@map("dispute_logs")
}

// ==============================================================================
// 5. RELAYER GAS FUNDING & AUDIT LOGS
// ==============================================================================

model RelayerFundingLog {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  txHash         String   @unique @map("tx_hash") @db.VarChar(128)
  senderWallet   String   @map("sender_wallet") @db.VarChar(100)
  relayerWallet  String   @map("relayer_wallet") @db.VarChar(100)
  amountSol      Decimal  @map("amount_sol") @db.Decimal(18, 9)
  amountLamports BigInt   @map("amount_lamports")
  adminUserId    String?  @map("admin_user_id") @db.Uuid
  status         String   @default("CONFIRMED") @db.VarChar(20)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser      User?    @relation("AdminRelayerFunding", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([senderWallet])
  @@index([relayerWallet])
  @@index([createdAt])
  @@map("relayer_funding_logs")
}

// ==============================================================================
// 6. ADMINISTRATIVE AUDIT & FIAT-CRYPTO ON-RAMP MODELS
// ==============================================================================

enum AuditActionType {
  OVERRIDE_SETTLE
  OVERRIDE_REFUND
  FREEZE_USER
  UNFREEZE_USER
  ROLE_CHANGE
  FUND_RELAYER
  FIAT_CRYPTO_SWAP

  @@map("audit_action_type_enum")
}

enum FiatFundingStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  CANCELLED

  @@map("fiat_funding_status_enum")
}

model AuditLog {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adminId        String?         @map("admin_id") @db.Uuid
  actionType     AuditActionType @map("action_type")
  targetEntityId String          @map("target_entity_id") @db.VarChar(128)
  payloadBefore  Json?           @map("payload_before")
  payloadAfter   Json?           @map("payload_after")
  auditReason    String          @map("audit_reason") @db.Text
  txHash         String?         @map("tx_hash") @db.VarChar(128)
  ipAddress      String?         @map("ip_address") @db.VarChar(45)
  userAgent      String?         @map("user_agent") @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  admin          User?           @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([actionType])
  @@index([targetEntityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FiatCryptoFundingOrder {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderCode       BigInt            @unique @map("order_code")
  adminId         String?           @map("admin_id") @db.Uuid
  recipientWallet String            @map("recipient_wallet") @db.VarChar(100)
  fiatCurrency    String            @default("VND") @map("fiat_currency") @db.VarChar(10)
  fiatAmount      Decimal           @map("fiat_amount") @db.Decimal(18, 4)
  cryptoCurrency  String            @default("SOL") @map("crypto_currency") @db.VarChar(10)
  cryptoAmount    Decimal           @map("crypto_amount") @db.Decimal(18, 9)
  exchangeRate    Decimal           @map("exchange_rate") @db.Decimal(18, 4)
  status          FiatFundingStatus @default(PENDING)
  paymentGateway  String            @default("VIETQR_PAYOS") @map("payment_gateway") @db.VarChar(50)
  paymentRefId    String?           @map("payment_ref_id") @db.VarChar(100)
  qrUrl           String?           @map("qr_url") @db.Text
  solanaTxHash    String?           @map("solana_tx_hash") @db.VarChar(128)
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  admin           User?             @relation("AdminFiatOrders", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([recipientWallet])
  @@index([status])
  @@index([orderCode])
  @@map("fiat_crypto_funding_orders")
}

// ==============================================================================
// 7. EMERGENCY ALERTS & MAILING LIST (TASK-c-4)
// ==============================================================================

model EmergencyMailingList {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email     String   @unique @db.VarChar(255)
  label     String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  addedBy   String?  @map("added_by") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("emergency_mailing_lists")
}

model EmergencyDispatchLog {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  alertType    String   @map("alert_type") @db.VarChar(50)
  severity     String   @default("CRITICAL") @db.VarChar(20)
  recipients   Json     @map("recipients")
  subject      String   @db.VarChar(255)
  status       String   @db.VarChar(20)
  errorMessage String?  @map("error_message") @db.Text
  latencyMs    Int      @map("latency_ms")
  triggeredBy  String   @default("SYSTEM") @map("triggered_by") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@index([alertType])
  @@index([createdAt])
  @@map("emergency_dispatch_logs")
}

// ==============================================================================
// 8. PUSH NOTIFICATIONS & FCM DEVICE TOKENS (TASK-c-8)
// ==============================================================================

enum DevicePlatform {
  ANDROID
  IOS

  @@map("device_platform_enum")
}

model DeviceToken {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  token       String         @unique @db.VarChar(512)
  platform    DevicePlatform
  deviceModel String?        @map("device_model") @db.VarChar(150)
  appVersion  String?        @map("app_version") @db.VarChar(50)
  isActive    Boolean        @default(true) @map("is_active")
  lastUsedAt  DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("device_tokens")
}
