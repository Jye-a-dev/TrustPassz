// apps/server/prisma/schema.prisma
// ==============================================================================
// TRUSTPASSZ HYBRID DATABASE SCHEMA (TASK-03)
// Primary Relational Engine: Neon PostgreSQL (pgBouncer Pool + Direct DDL)
// Auxiliary BaaS Engine: Supabase (Evidence Storage & Deal Room Realtime)
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// ==============================================================================
// 1. ENUMS DEFINITIONS
// ==============================================================================

enum UserRole {
  USER
  ADMIN
  ARBITRATOR

  @@map("user_role_enum")
}

enum DealState {
  PENDING
  DEPOSITED
  IN_INSPECTION
  SETTLED
  REFUNDED
  DISPUTED

  @@map("deal_state_enum")
}

enum AssetType {
  SOURCE_CODE
  LICENSE_KEY
  ACCOUNT_CREDENTIAL
  DESIGN_ASSET
  OTHER

  @@map("asset_type_enum")
}

enum DisputeStatus {
  OPENED
  AI_PROCESSING
  AI_RESOLVED
  ADMIN_ESCALATED
  CLOSED

  @@map("dispute_status_enum")
}

enum ArbitrationVerdict {
  APPROVE_PAYOUT
  TRIGGER_REFUND
  ESCALATE_TO_ADMIN

  @@map("arbitration_verdict_enum")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD_OUT
  ARCHIVED

  @@map("product_status_enum")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_ESCROW
  PROCESSING
  SHIPPING
  IN_INSPECTION
  COMPLETED
  DISPUTED
  CANCELLED

  @@map("order_status_enum")
}

enum BargainStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("bargain_status_enum")
}

// ==============================================================================
// 2. CORE IDENTITY & SOCIAL-COMMERCE MODELS
// ==============================================================================

model User {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String?  @unique @db.VarChar(255)
  phone         String?  @unique @db.VarChar(20)
  walletAddress String?  @unique @map("wallet_address") @db.VarChar(42)
  displayName   String?  @map("display_name") @db.VarChar(100)
  avatarUrl     String?  @map("avatar_url") @db.Text
  role          UserRole @default(USER)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  storefront        Storefront?
  sellerProducts    Product[]      @relation("SellerProducts")
  sellerDeals       Deal[]         @relation("SellerDeals")
  buyerDeals        Deal[]         @relation("BuyerDeals")
  buyerOrders       Order[]        @relation("BuyerOrders")
  sellerOrders      Order[]        @relation("SellerOrders")
  bargainOffers     BargainOffer[] @relation("BuyerBargains")
  initiatedDisputes DisputeLog[]   @relation("InitiatorDisputes")
  resolvedDisputes  DisputeLog[]   @relation("ResolverDisputes")

  @@map("users")
}

model Storefront {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sellerId     String   @unique @map("seller_id") @db.Uuid
  slug         String   @unique @db.VarChar(100)
  shopName     String   @map("shop_name") @db.VarChar(150)
  bio          String?  @db.Text
  customConfig Json     @default("{\"theme\":\"dark\",\"social_links\":{},\"banner_url\":null,\"canvas_layout\":[]}") @map("custom_config")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller   User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("storefronts")
}

model Product {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sellerId       String        @map("seller_id") @db.Uuid
  storefrontId   String?       @map("storefront_id") @db.Uuid
  title          String        @db.VarChar(255)
  category       String        @db.VarChar(50)
  basePrice      Decimal       @map("base_price") @db.Decimal(18, 4)
  floorPrice     Decimal?      @map("floor_price") @db.Decimal(18, 4)
  currency       String        @default("VND") @db.VarChar(10)
  status         ProductStatus @default(ACTIVE)
  specAttributes Json          @default("{\"tags\":[],\"media_gallery\":[],\"ai_defect_fingerprints\":[],\"delivery_method\":\"INSTANT_VAULT\"}") @map("spec_attributes")
  ruleConfig     Json          @default("{\"inspection_hours\":12,\"allow_bargain\":true,\"deposit_fee_rate\":1.0,\"anti_boom_deposit_amount\":0}") @map("rule_config")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller        User           @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Restrict)
  storefront    Storefront?    @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  orders        Order[]
  bargainOffers BargainOffer[]

  @@index([sellerId])
  @@index([status])
  @@map("products")
}

// ==============================================================================
// 3. CORE ESCROW, ORDERS & REALTIME BARGAIN MODELS
// ==============================================================================

model Deal {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  onchainDealId         String?   @unique @map("onchain_deal_id") @db.VarChar(66)
  sellerId              String    @map("seller_id") @db.Uuid
  buyerId               String?   @map("buyer_id") @db.Uuid
  title                 String    @db.VarChar(255)
  description           String?   @db.Text
  amount                Decimal   @db.Decimal(18, 4)
  currency              String    @default("VND") @db.VarChar(10)
  state                 DealState @default(PENDING)
  inspectionDuration    Int       @default(86400) @map("inspection_duration")
  depositedAt           DateTime? @map("deposited_at") @db.Timestamptz(6)
  inspectionDeadline    DateTime? @map("inspection_deadline") @db.Timestamptz(6)
  paymentOrderCode      BigInt?   @unique @map("payment_order_code")
  paymentRefId          String?   @map("payment_ref_id") @db.VarChar(100)
  webhookIdempotencyKey String?   @unique @map("webhook_idempotency_key") @db.VarChar(128)
  settleTxHash          String?   @map("settle_tx_hash") @db.VarChar(66)
  disputeTxHash         String?   @map("dispute_tx_hash") @db.VarChar(66)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller       User          @relation("SellerDeals", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer        User?         @relation("BuyerDeals", fields: [buyerId], references: [id], onDelete: SetNull)
  order        Order?
  digitalAsset DigitalAsset?
  disputeLogs  DisputeLog[]

  @@index([sellerId])
  @@index([buyerId])
  @@index([state])
  @@index([onchainDealId])
  @@index([paymentOrderCode])
  @@map("deals")
}

model Order {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderNumber     String      @unique @map("order_number") @db.VarChar(64)
  dealId          String      @unique @map("deal_id") @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  sellerId        String      @map("seller_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  status          OrderStatus @default(PENDING_PAYMENT)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(18, 4)
  shippingInfo    Json        @default("{\"is_physical\":false,\"recipient_email\":null,\"shipping_address\":null,\"carrier_tracking_code\":null,\"carrier_name\":null,\"shipping_fee\":0}") @map("shipping_info")
  paymentMetadata Json        @default("{}") @map("payment_metadata")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Restrict)
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller  User    @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("orders")
}

model BargainOffer {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  buyerId         String        @map("buyer_id") @db.Uuid
  offeredPrice    Decimal       @map("offered_price") @db.Decimal(18, 4)
  status          BargainStatus @default(PENDING)
  negotiationData Json          @default("{\"buyer_note\":\"\",\"ai_suggested\":false,\"session_socket_id\":null}") @map("negotiation_data")
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation("BuyerBargains", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([buyerId])
  @@map("bargain_offers")
}

// ==============================================================================
// 4. DIGITAL VAULT & ARBITRATION MODELS
// ==============================================================================

model DigitalAsset {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  dealId           String    @unique @map("deal_id") @db.Uuid
  assetType        AssetType @default(SOURCE_CODE) @map("asset_type")
  encryptedContent String    @map("encrypted_content") @db.Text
  encryptionIv     String    @map("encryption_iv") @db.VarChar(64)
  authTag          String    @map("auth_tag") @db.VarChar(64)
  contentHash      String?   @map("content_hash") @db.VarChar(64)
  fileName         String?   @map("file_name") @db.VarChar(255)
  fileSizeBytes    BigInt?   @map("file_size_bytes")
  accessCount      Int       @default(0) @map("access_count")
  maxAccessLimit   Int       @default(1) @map("max_access_limit")
  unlockedAt       DateTime? @map("unlocked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("digital_assets")
}

model DisputeLog {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  dealId            String              @map("deal_id") @db.Uuid
  initiatorId       String              @map("initiator_id") @db.Uuid
  status            DisputeStatus       @default(OPENED)
  reason            String              @db.Text
  evidenceUrls      Json                @default("[]") @map("evidence_urls")
  aiVerdict         ArbitrationVerdict? @map("ai_verdict")
  aiConfidenceScore Decimal?            @map("ai_confidence_score") @db.Decimal(5, 4)
  aiExplanation     String?             @map("ai_explanation") @db.Text
  aiAnalyzedAt      DateTime?           @map("ai_analyzed_at") @db.Timestamptz(6)
  adminVerdict      ArbitrationVerdict? @map("admin_verdict")
  resolvedById      String?             @map("resolved_by_id") @db.Uuid
  resolutionNote    String?             @map("resolution_note") @db.Text
  resolvedAt        DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  deal       Deal  @relation(fields: [dealId], references: [id], onDelete: Restrict)
  initiator  User  @relation("InitiatorDisputes", fields: [initiatorId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("ResolverDisputes", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([status])
  @@map("dispute_logs")
}
